<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Game language</string>
			<key>FooterText</key>
			<string>Takes effect after relaunching the game</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSRadioGroupSpecifier</string>
			<key>Key</key>
			<string>TOTK_LANG</string>
			<key>Title</key>
			<string>Language</string>
			<key>DefaultValue</key>
			<string></string>
			<key>Values</key>
			<array>
				<string></string>
				<string>zh-Hant</string>
				<string>zh-Hans</string>
				<string>en-US</string>
				<string>ja</string>
				<string>de</string>
				<string>es</string>
				<string>fr</string>
				<string>it</string>
				<string>nl</string>
				<string>ru</string>
				<string>ko</string>
			</array>
			<key>Titles</key>
			<array>
				<string>Automatic (follow the system language)</string>
				<string>Chinese (Traditional)</string>
				<string>Chinese (Simplified)</string>
				<string>English</string>
				<string>Japanese</string>
				<string>German</string>
				<string>Spanish</string>
				<string>French</string>
				<string>Italian</string>
				<string>Dutch</string>
				<string>Russian</string>
				<string>Korean</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Display</string>
			<key>FooterText</key>
			<string>On: the game's docked settings, 1920×1080 output, 1600×900 inside (for a fast iPad). Off: handheld 1280×720 (960×540 inside). Takes effect after relaunching the game</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Key</key>
			<string>TOTK_DOCKED</string>
			<key>TOTKPhone</key>
			<true/>
			<key>Title</key>
			<string>Full HD (docked)</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Frame rate</string>
			<key>FooterText</key>
			<string>30 is steadier and keeps the phone cooler; the 60 / 30 button between − and + of the touch controls switches it while playing</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Key</key>
			<string>TOTK_PHONE_FPS</string>
			<key>TOTKPhone</key>
			<true/>
			<key>Title</key>
			<string>Frame rate</string>
			<key>DefaultValue</key>
			<string>60</string>
			<key>Values</key>
			<array>
				<string>60</string>
				<string>30</string>
			</array>
			<key>Titles</key>
			<array>
				<string>Up to 60</string>
				<string>Held at 30</string>
			</array>
